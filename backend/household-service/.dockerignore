# Maven build files
target/
!target/*.jar

# IDE files
.idea/
*.iml
.vscode/
*.sublime-*
.settings/
.project
.classpath

# Git files
.git/
.gitignore

# Logs
*.log
logs/

# Temporary files
*.tmp
*.swp
*.swo
tmp/

